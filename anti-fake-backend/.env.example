PORT=3000
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# --- Database (Supabase Postgres) ---
# DATABASE_URL: dung connection string "Transaction" pooler (PgBouncer, port 6543)
# tu Supabase Dashboard > Project Settings > Database > Connection string.
# DIRECT_URL: dung connection string "Session"/truc tiep (port 5432) - Prisma
# can url nay rieng de chay migrate (PgBouncer khong ho tro prepared statements
# ma Prisma migrate can dung).
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (luu anh bao cao hang gia - CU-03) ---
# Lay tai Supabase Dashboard > Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY: dung key "service_role" (KHONG PHAI "anon key"),
# vi can quyen ghi vao bucket. Day la secret nhay cam - CHI dat o backend,
# KHONG BAO GIO dua vao code frontend.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Key rieng bao ve thao tac them/sua danh sach hang gia da xac nhan
# (POST /api/v1/counterfeit-alerts) - tu dat mot chuoi ngau nhien, dua vao
# header "x-admin-key" khi goi API. Xem AdminKeyGuard.
ADMIN_API_KEY="tu-dat-mot-chuoi-ngau-nhien-rieng-cho-admin"

REDIS_URL="redis://localhost:6379"

# Pepper dung khi hash secret code (muc 4.2/4.3 SRS) - PHAI la chuoi ngau nhien
# dai, giu bi mat tuyet doi, KHONG commit gia tri that vao git. Doi pepper se
# lam vo hieu toan bo secret_hash da luu trong DB, nen chi doi khi that su can
# xoay khoa (key rotation) va co ke hoach migrate di kem.
SECRET_HASH_PEPPER="doi-gia-tri-nay-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu"

# Bi mat ky JWT cho dang nhap Web Admin (muc 7 SRS) - doi thanh chuoi ngau
# nhien rieng, khac voi SECRET_HASH_PEPPER.
JWT_SECRET="doi-gia-tri-nay-thanh-chuoi-ngau-nhien-khac-toi-thieu-32-ky-tu"
